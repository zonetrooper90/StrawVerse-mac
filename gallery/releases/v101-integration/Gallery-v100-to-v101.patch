+/* Keep the View History tile immediately after the last visible cover. Reserve space
+   for any one expanded card so neither it nor the shortcut clips at the row edge.
+   No fixed breakpoint-count guesses: fit is based on the row's real available width. */
+let whRecentResizeObserver=null;
+function whSetupRecentPreview(content){
+ if(whRecentResizeObserver){whRecentResizeObserver.disconnect();whRecentResizeObserver=null;}
+ const row=content.querySelector('.wh-recent-row');if(!row)return;
+ const covers=[...row.querySelectorAll('.wh-recent-item')];
+ const fit=()=>{
+  const width=row.clientWidth;if(width<=0)return;
+  const coverWidth=66,gap=10;
+  // On a very narrow window the info panel scales to the remaining space.
+  const panelWidth=Math.min(188,Math.max(55,width-coverWidth*2-gap));
+  row.style.setProperty('--wh-panel-width',panelWidth+'px');
+  const max=Math.max(1,Math.floor((width-coverWidth-panelWidth)/(coverWidth+gap)));
+  covers.forEach((item,index)=>{item.classList.toggle('is-preview-hidden',index>=max);});
+ };
+ fit();
+ if(typeof ResizeObserver==='function'){
+  whRecentResizeObserver=new ResizeObserver(fit);whRecentResizeObserver.observe(row);
+ }else window.addEventListener('resize',fit,{passive:true});
+}
