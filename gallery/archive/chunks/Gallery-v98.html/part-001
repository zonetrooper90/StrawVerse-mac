.episode-actions{display:flex;gap:5px;align-items:center}.episode-actions .iconbtn{width:35px;height:35px;background:var(--raised);color:var(--accent);border:1px solid var(--line)}.episode-actions .iconbtn:hover{background:var(--hover)}
.episode-note{font-size:11px;color:var(--muted);margin-top:15px;line-height:1.5}
.audio-choose{display:flex;gap:9px;margin:18px 0 10px}.audio-choose label{flex:1;display:block}.audio-choose input{position:absolute;opacity:0}.audio-choose span{display:block;background:var(--raised);border:1px solid var(--line);border-radius:10px;padding:13px 12px;text-align:center;font-weight:700;cursor:pointer}.audio-choose input:checked + span{border-color:var(--accent);background:var(--strong)}.audio-choose input:focus-visible + span{outline:2px solid var(--accent);outline-offset:3px}
.audio-choose input:disabled + span{opacity:.48;cursor:not-allowed}
