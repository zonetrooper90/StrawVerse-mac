/* v0.14 — Watch uses the already-selected Sub/Dub version and opens a player
   preview directly. This replaces the redundant audio-selection dialog. */
.playback-page{max-width:1120px;margin:auto;min-width:0}
.playback-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:22px 0 19px;flex-wrap:wrap}
.playback-heading h1{font-size:clamp(24px,3vw,35px);margin:0 0 8px}
.playback-meta{font-size:13px;color:var(--muted);margin:0;line-height:1.6}
.playback-audio{border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:12px;color:var(--ink);background:var(--surface);white-space:nowrap}
.playback-screen{width:100%;aspect-ratio:16/9;border-radius:17px;border:1px solid var(--line);background:radial-gradient(ellipse at 50% 44%,var(--raised) 0%,var(--window) 72%);display:grid;place-items:center;min-height:210px;overflow:hidden}
.playback-screen-center{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:11px;text-align:center;padding:16px;max-width:420px;color:var(--accent)}
.playback-screen-center strong{color:var(--ink);font-size:19px}
.playback-screen-center span{color:var(--muted);font-size:13px;line-height:1.5}
.playback-footnote{color:var(--muted);font-size:12px;line-height:1.7;max-width:720px;margin:17px 0}
@media(max-width:570px){.playback-heading{align-items:start;margin-top:15px}.playback-audio{font-size:11px}.playback-screen{min-height:210px}.playback-screen-center strong{font-size:17px}}


/* Custom player layout; design based on Gallery v0.14. */
body.desktop-build{padding:0;background:var(--window)}
body.desktop-build .app{width:100%;height:100vh;max-width:none;min-height:350px;border:0;border-radius:0;box-shadow:none}
body.desktop-build .top{-webkit-app-region:drag;padding-top:25px}
body.desktop-build .top button,body.desktop-build .tabs{-webkit-app-region:no-drag}
body.desktop-build *:not(input):not(textarea){-webkit-user-select:none;user-select:none}
body.desktop-build input,body.desktop-build textarea{-webkit-user-select:text;user-select:text}
.player-area{width:100%;position:relative;background:#050508;aspect-ratio:16/9;border:1px solid #332a3d;border-radius:17px;overflow:hidden;isolation:isolate}
.player-area video{width:100%;height:100%;display:block;object-fit:contain;background:#050508}
.player-area:fullscreen{border:0;border-radius:0;display:flex;align-items:center;justify-content:center;background:#050508}
.player-area:fullscreen video{max-height:100%}
.player-overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none;z-index:2;transition:opacity .30s ease-out}
.player-overlay>*{pointer-events:auto}
.player-top{padding:18px 20px 45px;background:linear-gradient(rgba(2,2,5,.85),transparent);display:flex;gap:16px;justify-content:space-between;align-items:start;color:#f4f1f7}
.player-top strong{font-size:14px}.player-top small{display:block;color:#d4cbdc;margin-top:5px;font-size:11px}
.player-bottom{padding:58px 21px 20px;background:linear-gradient(transparent,rgba(4,3,8,.94) 68%);color:#f8f5fc}
.player-controls{display:grid;grid-template-columns:1fr auto 1fr;gap:13px;align-items:center;margin-top:20px}
.player-controls .controls-left,.player-controls .controls-right,.player-controls .controls-middle{display:flex;align-items:center;gap:14px}
.player-controls .controls-left{justify-content:flex-start}.player-controls .controls-middle{justify-content:center}.player-controls .controls-right{justify-content:flex-end}
.player-icon{display:grid;place-items:center;border:0;background:transparent;color:#f5f0fa;width:35px;height:35px;border-radius:10px;padding:5px;flex:none}
.player-icon:hover{background:rgba(255,255,255,.14);color:var(--accent)}.player-icon:focus-visible{outline:2px solid var(--accent)}
.player-icon[aria-pressed="true"]{background:var(--tab);color:#fff}
.player-main-action{border:0;border-radius:50%;width:54px;height:54px;background:var(--tab);color:#fff;display:grid;place-items:center;box-shadow:0 3px 13px rgba(0,0,0,.28)}
.player-main-action:hover{filter:brightness(1.15)}.player-main-action:disabled{opacity:.5}
.player-progress-row{display:flex;gap:13px;align-items:center}
.player-time{font-size:11px;color:#eee8f4;white-space:nowrap;min-width:35px;font-variant-numeric:tabular-nums}
.player-time:last-child{text-align:right}
.player-progress{position:relative;min-width:0;flex:1;height:26px;display:flex;align-items:center;cursor:pointer}
.player-progress-bar{display:flex;width:100%;height:5px;gap:5px;align-items:center;position:relative}
.player-watched{height:5px;background:var(--accent);border-radius:8px;flex:0 0 0%}
.player-remaining{height:5px;background:var(--player-remaining);border-radius:8px;flex:1}
.player-progress input{position:absolute;inset:0;width:100%;height:100%;margin:0;cursor:pointer;opacity:0}
.player-scrub{position:absolute;left:0%;top:50%;transform:translate(-50%,-50%);border-radius:50%;width:12px;height:12px;background:var(--accent);box-shadow:0 0 0 2px #e8dff1;opacity:0;pointer-events:none;transition:opacity .1s}
.player-progress:hover .player-scrub,.player-progress:focus-within .player-scrub{opacity:1}
