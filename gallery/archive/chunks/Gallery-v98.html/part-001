/* v25 — Audio segmented pill, season overflow and action-aligned episode flags. */
.detail-audio-toggle{position:relative;isolation:isolate;overflow:hidden}
.detail-audio-highlight{position:absolute;left:4px;top:4px;bottom:4px;width:calc((100% - 12px)/2);border:1px solid var(--accent);border-radius:9px;background:var(--tab);transform:translateX(0);transition:transform .34s cubic-bezier(.22,.72,.19,1);pointer-events:none;z-index:0;box-sizing:border-box}
.detail-audio-toggle[data-active="dub"] .detail-audio-highlight{transform:translateX(calc(100% + 4px))}
.detail-audio-toggle button{z-index:1;position:relative;transition:color .18s ease,background .18s ease}
.detail-audio-toggle button[aria-pressed="true"]{background:transparent;border-color:transparent;color:var(--accent-ink)}
.detail-audio-toggle.is-returning .detail-audio-highlight{transition-duration:.52s;transition-timing-function:cubic-bezier(.20,.74,.18,1)}
.detail-audio-toggle button::before{content:"";position:absolute;inset:0;border:1px solid color-mix(in srgb,var(--accent) 60%,transparent);border-radius:8px;background:color-mix(in srgb,var(--accent) 8%,transparent);opacity:0;pointer-events:none;z-index:-1;transition:opacity .42s ease-in-out}
.detail-audio-toggle.is-hovering-other button[aria-pressed="true"]::before{opacity:1}
.detail-audio-toggle.is-hovering-other button[aria-pressed="true"]{color:var(--accent)}
.inline-installment-top[hidden],.inline-installment-arrows[hidden]{display:none!important}
.inline-arrow:disabled{opacity:.34;cursor:default;pointer-events:none}
.episode-item{grid-template-columns:44px minmax(0,1fr) auto}
.episode-tools{grid-column:3;display:flex;align-items:center;justify-content:flex-end;gap:12px;min-width:0}
.episode-copy{min-width:0}
@media(max-width:850px){
 .episode-item{grid-template-columns:36px minmax(0,1fr) auto;min-height:80px}
 .episode-tools{grid-column:3;grid-row:1;flex-direction:column;align-items:flex-end;gap:7px}
 .episode-flags{grid-column:auto;grid-row:auto;justify-content:flex-end;gap:4px}
 .episode-actions{grid-column:auto;grid-row:auto}
}
@media(max-width:570px){
 .episode-item{grid-template-columns:27px minmax(0,1fr) auto;gap:7px}
