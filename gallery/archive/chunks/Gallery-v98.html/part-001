 const downloaded=amount>0?`<div class="player-watched" style="flex-basis:${amount===100?'100%':`calc((100% - 5px) * ${amount/100})`}" aria-hidden="true"></div>`:'';
 const remaining=amount<100?'<div class="player-remaining" aria-hidden="true"></div>':'';
 return `<div class="player-progress-bar download-progress" role="progressbar" aria-label="${escapeHTML(label)}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${amount}">${downloaded}${remaining}</div>`;
}
function downloadGroupCanDismiss(entries){return entries.length>0&&entries.every(entry=>downloadTerminalStates.has(entry.status));}
