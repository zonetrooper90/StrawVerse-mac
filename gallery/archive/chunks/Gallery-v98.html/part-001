@media(max-width:570px){.episode-divider{margin-inline:4px}}
@media(prefers-reduced-motion:reduce){.detail-audio-highlight{transition:none}}

/* v0.10 — Connected seasons: title-first cards, independently selected installments,
   separate related films/specials, no synthetic streaming availability claims. */
.connected-section{border-top:1px solid var(--line);padding-top:20px;margin:0 0 24px}
.connected-section-header{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:13px}
.connected-section-header h2{font-size:19px;letter-spacing:-.03em;margin:0}
.connected-section-note{font-size:11px;color:var(--muted);line-height:1.4}
.connected-season-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(166px,1fr));gap:9px}
.connected-season-card{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0;min-height:105px;padding:13px 12px;text-align:left;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--ink);transition:border-color .15s,background .15s}
.connected-season-card:hover:not([aria-pressed="true"]){background:var(--hover)}
.connected-season-card[aria-pressed="true"]{border-color:var(--accent);background:var(--strong);box-shadow:0 0 0 1px var(--glow) inset}
.connected-season-copy{min-width:0;display:flex;flex-direction:column;gap:5px}
.connected-season-name{font-size:13px;font-weight:750;line-height:1.25;overflow-wrap:anywhere}
.connected-season-number{font-size:11px;color:var(--muted);line-height:1.3}
.connected-season-provider{font-size:10px;color:var(--muted);line-height:1.25;margin-top:2px}
.connected-season-card[aria-pressed="true"] .connected-season-provider{color:var(--ink)}
.connected-season-check{flex:none;color:var(--accent)}
.connected-related{margin-top:16px;border-top:1px solid var(--line);padding-top:15px}
.connected-related-header{font-size:12px;font-weight:740;color:var(--ink);margin-bottom:9px}
.connected-related-list{display:flex;gap:8px;flex-wrap:wrap}
.connected-related-button{background:var(--raised);border:1px solid var(--line);border-radius:10px;padding:10px 13px;display:flex;gap:10px;align-items:center;text-align:left;color:var(--ink);min-width:0}
.connected-related-button:hover:not([aria-pressed="true"]){background:var(--hover)}
.connected-related-button[aria-pressed="true"]{border-color:var(--accent);background:var(--strong)}
.connected-related-button b{display:block;font-size:12px;font-weight:700;line-height:1.35}
.connected-related-button small{display:block;font-size:10px;color:var(--muted);margin-top:3px}
.selected-installment{font-size:14px;color:var(--accent);font-weight:710;line-height:1.35;margin:-4px 0 11px}
.selected-installment small{font-size:11px;font-weight:560;color:var(--muted);display:block;margin-top:4px}
.installment-meta-note{font-size:11px;color:var(--muted);line-height:1.5;margin-top:9px}
.provider-unmatched{display:flex;gap:13px;align-items:flex-start;background:var(--surface);border:1px dashed var(--line);border-radius:12px;padding:18px;margin:10px 0 0}
.provider-unmatched strong{display:block;font-size:13px;margin-bottom:6px}
.provider-unmatched p{font-size:12px;color:var(--muted);line-height:1.5;margin:0}
.provider-unmatched .btn{flex:none}
@media(max-width:850px){.connected-season-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:570px){.connected-season-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.connected-season-card{padding:10px;min-height:99px}.connected-season-name{font-size:12px}.connected-section-header{align-items:flex-start;flex-direction:column;gap:4px}.provider-unmatched{flex-direction:column;gap:10px}}
@media(max-width:370px){.connected-season-list{grid-template-columns:1fr}.connected-season-card{min-height:72px}}

/* v0.12 — in-context installment navigation. Nothing opens over the episode list. */
.inline-installments{margin-bottom:20px}
.inline-installment-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
.inline-installment-arrows{display:flex;gap:5px;flex:none}
.inline-installment-top[data-only-arrows="true"]{justify-content:flex-end}
.inline-arrow{display:grid;place-items:center;background:var(--surface);color:var(--muted);border:1px solid var(--line);height:31px;width:31px;border-radius:9px}
.inline-arrow:hover{background:var(--hover);color:var(--ink)}
.inline-arrow:focus-visible,.inline-installment-card:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.inline-arrow.previous .icon{transform:rotate(180deg)}
.inline-installment-rail{width:100%;display:flex;gap:8px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;scrollbar-width:thin;scrollbar-color:var(--line) transparent;padding:1px 0 6px}
.inline-installment-card{display:flex;flex:0 0 clamp(180px,25%,290px);align-items:center;justify-content:space-between;gap:8px;min-height:66px;max-width:290px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:10px 12px;text-align:left;scroll-snap-align:start;transition:border-color .12s,background .12s}
.inline-installment-card:hover:not([aria-current="true"]){background:var(--hover)}
.inline-installment-card[aria-current=true]{background:var(--strong);border-color:var(--accent)}
.inline-installment-card .installment-name{font-size:12px;font-weight:750;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.inline-installment-card .installment-number{font-size:11px;line-height:1.4;color:var(--muted);display:block;margin-top:4px}
.inline-installment-card .icon{color:var(--accent);flex:none}
.inline-installment-card:not([aria-current=true]) .icon{display:none}
.inline-installment-rail:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.detail-section-head.installment-section-head{align-items:center;gap:12px;margin-bottom:12px}
.detail-section-head.installment-section-head .season-select{display:block;overflow-wrap:anywhere;text-align:right}
@media(max-width:700px){
 .inline-installment-card{flex-basis:clamp(170px,55%,240px)}
 .inline-installments{margin-bottom:14px}
}
@media(max-width:460px){
 .inline-installment-top{gap:5px}
 
 .inline-arrow{width:29px;height:29px}
 .inline-installment-card{flex-basis:76%;max-width:245px}
 .inline-installment-card .installment-name{font-size:12px}
 .detail-section-head.installment-section-head{flex-direction:row;align-items:baseline}
}

/* v0.14 — Responsive, in-context playback row.
   Wide layouts retain the original action panel at the right.
   Below 1050px, the poster and series details occupy the first row, while
   audio / Watch / Tags share a single full-width row beneath both.
   No overlay, no new panel height, and no lost episode context. */
.detail-action-label-short{display:none}
