const SUBTITLE_PREVIEW_TEXT='The quick brown fox\njumps over the lazy dog.';
/* v93 — Five user-facing, named relative subtitle sizes. The values below are
   reference units at a 1080-high displayed video area (not physical display
   pixels, not source-video dimensions). Only the names appear in the UI.
   Persist stable preset IDs, never a resolution-specific font size. */
const SUBTITLE_SIZES=Object.freeze([
 {id:'extra-small',label:'Extra Small',reference:28},
 {id:'small',label:'Small',reference:36},
 {id:'normal',label:'Normal',reference:44},
 {id:'large',label:'Large',reference:54},
 {id:'extra-large',label:'Extra Large',reference:64}
]);
const SUBTITLE_DEFAULTS=Object.freeze({font:'system',size:'normal',color:'#f5f5f5',colorMode:'white',customColor:'#ffffff',customColorSet:false,outline:3,outlineColor:'#08080b',shadow:3,shadowColor:'#08080b',boxOpacity:65,boxColor:'#08080b',effect:'outline',outlinePreset:'normal',shadowPreset:'normal',boxPreset:'normal',});
const SUBTITLE_TEXT_COLOR_PRESETS=Object.freeze({white:'#f5f5f5',yellow:'#ffe066'});
// A10 — Consistent Subtle / Normal / Strong labels under Effect intensity.
// The UI offers named effect presets, while the renderer still uses numbers.
// Outline values respect the existing font-size-dependent maximum.
const SUBTITLE_EFFECT_PRESETS=Object.freeze({
 outline:{light:1,normal:3,strong:5},
 shadow:{light:1.5,normal:3,strong:6},
 box:{light:35,normal:65,strong:85}
});
const SUBTITLE_EFFECT_LABELS=Object.freeze(['Subtle','Normal','Strong']);
function subtitlePresetValue(effect,preset,size){
 const n=SUBTITLE_EFFECT_PRESETS[effect]?.[preset]??SUBTITLE_EFFECT_PRESETS[effect]?.normal??0;
 return effect==='outline'?Math.min(maximumSubtitleOutline(size),n):n;
}
function subtitleNearestPreset(effect,value,size){
 const presets=Object.keys(SUBTITLE_EFFECT_PRESETS[effect]||{});
 return presets.reduce((best,id)=>Math.abs(subtitlePresetValue(effect,id,size)-value)<Math.abs(subtitlePresetValue(effect,best,size)-value)?id:best,'normal');
}
function assignSubtitlePresetNumbers(prefs){
 for(const [effect,key,presetKey] of [['outline','outline','outlinePreset'],['shadow','shadow','shadowPreset'],['box','boxOpacity','boxPreset']]){
  prefs[key]=subtitlePresetValue(effect,prefs[presetKey],prefs.size);
 }
}

function normalizeSubtitleSize(size){
 if(typeof size==='string' && SUBTITLE_SIZES.some(entry=>entry.id===size))return size;
 // Migrate saved v82–v92 numeric sizes to the nearest named preset.
 if(typeof size==='number' && Number.isFinite(size))
  return SUBTITLE_SIZES.reduce((best,entry)=>Math.abs(entry.reference-size)<Math.abs(best.reference-size)?entry:best).id;
 return SUBTITLE_DEFAULTS.size;
}
function subtitleReferenceSize(size){
 return (SUBTITLE_SIZES.find(entry=>entry.id===size)||SUBTITLE_SIZES[2]).reference;
}
// Same proportional cap as v88: one eighth of the reference font size,
// rounded down to half-steps and never above six reference units.
function maximumSubtitleOutline(size){return Math.min(6,Math.floor(subtitleReferenceSize(size)/4)/2)}
const SUBTITLE_FONTS=Object.freeze({system:'-apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif',atkinson:'"Atkinson Hyperlegible Next", -apple-system, sans-serif',inter:'Inter, -apple-system, sans-serif'});
function readSubtitlePrefs(){
 try{
  const raw=JSON.parse(localStorage.getItem('gallery.layoutExperimentA.subtitlePreview')||'{}');
  if(!raw||typeof raw!=='object')return {...SUBTITLE_DEFAULTS};
  const v={...SUBTITLE_DEFAULTS};
  if(Object.hasOwn(SUBTITLE_FONTS,raw.font))v.font=raw.font;
  v.size=normalizeSubtitleSize(raw.size);
  for(const [key,min,max] of [['outline',0,6],['shadow',0,10]])
   if(Number.isFinite(raw[key]))v[key]=Math.max(min,Math.min(max,Math.round(raw[key]*2)/2));
  v.outline=Math.min(v.outline,maximumSubtitleOutline(v.size));
  if(Number.isFinite(raw.boxOpacity))v.boxOpacity=Math.max(0,Math.min(100,Math.round(raw.boxOpacity/5)*5));
  for(const key of ['color','outlineColor','shadowColor','boxColor'])
   if(/^#[0-9a-fA-F]{6}$/.test(raw[key]||''))v[key]=raw[key].toLowerCase();
   // Legacy copies stored only a hex value. Treat the former #FFFFFF default
   // as the new Soft White preset; preserve all other user-selected colors.
   const validHex=c=>typeof c==='string' && /^#[0-9a-fA-F]{6}$/.test(c);
   if(['white','yellow','custom'].includes(raw.colorMode)){
    v.colorMode=raw.colorMode;
    if(validHex(raw.customColor))v.customColor=raw.customColor.toLowerCase();
    else if(v.colorMode==='custom' && validHex(raw.color))v.customColor=raw.color.toLowerCase();
   }else if(validHex(raw.color)){
    const previous=raw.color.toLowerCase();
    if(previous==='#ffe066')v.colorMode='yellow';
    else if(previous!=='#ffffff' && previous!=='#f5f5f5'){
     v.colorMode='custom';v.customColor=previous;
    }
   }
   // Older experiments did not store whether Custom had ever been chosen.
   // A nondefault saved swatch or a previously selected Custom mode implies yes.
   v.customColorSet=typeof raw.customColorSet==='boolean'
    ?raw.customColorSet
    :(v.colorMode==='custom'||v.customColor!==SUBTITLE_DEFAULTS.customColor);
   v.color=v.colorMode==='custom'?v.customColor:SUBTITLE_TEXT_COLOR_PRESETS[v.colorMode];
   if(!Object.hasOwn(raw,'shadowColor'))v.shadowColor=v.outlineColor;
  if(['outline','shadow','box','none'].includes(raw.effect))v.effect=raw.effect;
  // Migrate the separate background selector from v95 to the unified style.
  // When an old background was enabled, preserve that explicit choice.
  if(['solid','translucent'].includes(raw.background) && !['box','none'].includes(raw.effect)){
   v.effect='box';v.boxOpacity=raw.background==='solid'?100:60;
  }
  // Existing A8 slider settings are mapped to their nearest A9 named preset.
  for(const [effect,key,presetKey] of [['outline','outline','outlinePreset'],['shadow','shadow','shadowPreset'],['box','boxOpacity','boxPreset']]){
   const saved=raw[presetKey];
   v[presetKey]=['light','normal','strong'].includes(saved)?saved:subtitleNearestPreset(effect,v[key],v.size);
  }
  assignSubtitlePresetNumbers(v);
  return v;
 }catch{return {...SUBTITLE_DEFAULTS};}
}
